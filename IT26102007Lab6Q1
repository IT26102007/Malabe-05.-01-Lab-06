import java.util.Scanner; 
 
public class IT26101914Lab6Q1 { 
    public static void main(String[] args) { 
 
       //Declare the variables
	     double number,square,squareRoot;
		 
	   //Create a Scanner object to read input
	   Scanner input = new Scanner(System.in);
	   
	   //Take the user inputs
	   System.out.print("Enter a number: ");
	   number = input.nextDouble();
	   
	   //Validate the input
	   if (number <= 0){
	      System.out.println(" Error : The number must be greater than zero");
	   }
	   else {
	   //Calculate the squre of the number
	   square = number * number;
	   
	   //Calculate the square root of the number
	   squareRoot = Math.sqrt(number);
	   
	   //Display the square and square root
	     System.out.println();
	   System.out.println("The square of " + number + " is : " + square );
	   System.out.println("The square root of " + number + " is : "  + squareRoot );
	   }
	   
	}

}